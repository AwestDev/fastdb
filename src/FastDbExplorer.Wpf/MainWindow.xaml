<Window x:Class="FastDbExplorer.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FastDbExplorer.Wpf.ViewModels"
        xmlns:views="clr-namespace:FastDbExplorer.Wpf.Views"
        xmlns:l="clr-namespace:FastDbExplorer.Wpf.Localization"
        Title="GeoNexus" Icon="pack://application:,,,/Assets/app.ico" Width="1180" Height="760" MinWidth="960" MinHeight="640"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft" UseLayoutRounding="True"
        FontFamily="{StaticResource AppFont}" FontSize="14"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
  <!-- Custom title bar: the system one follows the RTL flow (buttons on the left), so it is replaced by our own. -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:ConnectionViewModel}"><views:ConnectionsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ConnectPromptViewModel}"><views:ConnectPromptView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ExplorerViewModel}"><views:ExplorerView /></DataTemplate>
    <!-- The map is NOT created by this template: one MapView lives in MapHost below and is only hidden/shown (see MainWindow.xaml.cs),
         so coming back to the Map section does not rebuild the WebView2 page. -->
    <DataTemplate DataType="{x:Type vm:MapViewModel}"><Border /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:MonitoringViewModel}"><views:MonitoringView /></DataTemplate>

    <!-- Flat caption button; the hover colour comes from BorderBrush so the close button can use red -->
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="40" />
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" /></Trigger>
      </Style.Triggers>
    </Style>

    <!-- Navigation rail button (DataContext = NavItemViewModel): icon above a small label; accent colours when selected -->
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="Margin" Value="0,0,0,28" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="12" Background="{TemplateBinding Background}" Padding="0,10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.8" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.8" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid x:Name="RootGrid">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

    <!-- Title bar (always left-to-right): icon + name at the top left, window buttons at the top right -->
    <Border Grid.Row="0" Height="40" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" FlowDirection="LeftToRight">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
          <Image Source="pack://application:,,,/Assets/app.ico" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Text="{x:Static l:WindowStrings.AppName}" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="{x:Static l:WindowStrings.Minimize}" Click="OnMinimize" />
          <Button x:Name="MaxRestoreButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="{x:Static l:WindowStrings.Maximize}" Click="OnMaximizeRestore" />
          <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="{x:Static l:WindowStrings.Close}" Click="OnClose" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Body: navigation rail (first column = right side in RTL) | top bar + current section -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

      <!-- Navigation rail: Home, Connections, Explorer, Map, Monitoring -->
      <Border Grid.Column="0" Width="84" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
        <StackPanel Margin="8,12,8,8">
          <!-- App logo above the navigation -->
          <Image Source="pack://application:,,,/Assets/logo.png" Width="44" Height="44" Margin="0,0,0,16" HorizontalAlignment="Center"
                 RenderOptions.BitmapScalingMode="HighQuality" />
          <ItemsControl ItemsSource="{Binding NavItems}" IsTabStop="False" Margin="0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource NavButton}" Margin="0,0,0,28" ToolTip="{Binding ToolTipText}"
                      Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding Section}">
                <Grid>
                  <StackPanel HorizontalAlignment="Center">
                    
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  </StackPanel>
                  <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,6,0" MinWidth="18" Height="18" CornerRadius="9" Padding="4,0"
                          Background="{DynamicResource DangerBrush}" Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </StackPanel>
      </Border>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <!-- Top bar: connection status, active profile/database, disconnect -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,8" MinHeight="52">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
                    <Style.Triggers><DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}" /></DataTrigger></Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock Text="{Binding ServerName}" FlowDirection="LeftToRight" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"
                          TextTrimming="CharacterEllipsis" MaxWidth="180" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />
              <TextBlock Text="{x:Static l:ShellStrings.NotConnected}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                    <Style.Triggers><DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>

            <ComboBox x:Name="ActiveProfileComboBox" Grid.Column="1" Width="170" Margin="16,0,0,0" VerticalAlignment="Center"
                      ToolTip="{x:Static l:ShellStrings.ActiveProfile}" ItemsSource="{Binding Profiles}" SelectedItem="{Binding ActiveProfile, Mode=OneWay}"
                      IsSynchronizedWithCurrentItem="False" SelectionChanged="OnActiveProfileSelectionChanged">
              <ComboBox.Style>
                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                  <Style.Triggers><DataTrigger Binding="{Binding Profiles.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                </Style>
              </ComboBox.Style>
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel FlowDirection="RightToLeft">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Server}" FlowDirection="LeftToRight" HorizontalAlignment="Left" Style="{StaticResource Muted}" FontSize="10" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <ComboBox Grid.Column="2" Width="175" Margin="12,0,0,0" VerticalAlignment="Center" FlowDirection="LeftToRight"
                      ToolTip="{x:Static l:ShellStrings.ActiveDatabase}"
                      ItemsSource="{Binding Explorer.Databases}" SelectedItem="{Binding Explorer.SelectedDatabase, Mode=TwoWay}"
                      Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>

            <Button Grid.Column="3" Command="{Binding OpenPaletteCommand}" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="16,0,0,0" Padding="12,8" ToolTip="Ctrl+K">
              <Grid Width="200">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{x:Static l:ShellStrings.SearchButton}" Style="{StaticResource Muted}" FontSize="13" Margin="10,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="Ctrl+K" FlowDirection="LeftToRight" Style="{StaticResource Muted}" VerticalAlignment="Center" />
              </Grid>
            </Button>

            <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE7E8;" FontSize="16" VerticalAlignment="Center"
                    ToolTip="{x:Static l:Strings.Disconnect}" Command="{Binding DisconnectCommand}"
                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />
          </Grid>
        </Border>

        <!-- Current section. The map is the exception: its view is created on the first visit, then only hidden/shown. -->
        <Grid Grid.Row="1">
          <ContentControl Content="{Binding CurrentView}" IsTabStop="False" />
          <Grid x:Name="MapHost" />
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
