<Window x:Class="FastDbExplorer.Wpf.Views.AlertToastWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FastDbExplorer.Wpf.Localization"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}" FontSize="13">
  <Border Margin="12" Padding="16" Width="360" CornerRadius="14" Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" TextElement.Foreground="{DynamicResource TextBrush}">
    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.35" /></Border.Effect>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource AccentBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1" Margin="12,0,0,0">
        <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
        <TextBlock x:Name="BodyText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,10" />
        <StackPanel Orientation="Horizontal">
          <Button x:Name="OpenButton" Style="{StaticResource PrimaryButton}" Content="{x:Static l:MonitoringStrings.OpenReport}" Click="OnOpen" Padding="12,6" />
          <Button Content="{x:Static l:MonitoringStrings.Close}" Click="OnClose" Padding="12,6" Margin="8,0,0,0" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</Window>
