<Window x:Class="FastDbExplorer.Wpf.Views.CommandPaletteWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FastDbExplorer.Wpf.Localization"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Width="580" Height="440"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" UseLayoutRounding="True"
        FontFamily="{StaticResource AppFont}" FontSize="14"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}">
  <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Padding="14">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,10">
        <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Padding="38,10,12,10" />
        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource MutedBrush}"
                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
        <TextBlock Text="{x:Static l:ShellStrings.PaletteHint}" Foreground="{DynamicResource MutedBrush}"
                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="38,0,0,0" IsHitTestVisible="False">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Query}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
      </Grid>

      <ListBox Grid.Row="1" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected, Mode=TwoWay}" MouseDoubleClick="OnResultDoubleClick">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
              </StackPanel>
              <Border Grid.Column="2" Background="{DynamicResource AccentSoftBrush}" CornerRadius="7" Padding="8,2" VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock Text="{Binding Kind}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Grid.Row="1" Text="{x:Static l:ShellStrings.PaletteEmpty}" Style="{StaticResource Muted}" FontSize="13" Margin="6,12,0,0"
                 Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}" />
    </Grid>
  </Border>
</Window>
