<UserControl x:Class="FastDbExplorer.Wpf.Views.ConnectPromptView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="28">
    <Grid.Triggers>
      <EventTrigger RoutedEvent="FrameworkElement.Loaded">
        <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" /></Storyboard></BeginStoryboard>
      </EventTrigger>
    </Grid.Triggers>
    <Border Style="{StaticResource Card}" MaxWidth="560" Padding="34" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel>
        <Border Width="76" Height="76" CornerRadius="22" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left">
          <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="32" Foreground="{DynamicResource AccentBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" Margin="0,22,0,8" />
        <TextBlock Text="{Binding Body}" Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,24" />
        <Button Style="{StaticResource PrimaryButton}" Content="{Binding ButtonText}" Command="{Binding GoToConnectCommand}"
                HorizontalAlignment="Left" MinWidth="174" Padding="18,11" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>