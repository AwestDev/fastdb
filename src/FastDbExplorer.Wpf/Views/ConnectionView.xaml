<UserControl x:Class="FastDbExplorer.Wpf.Views.ConnectionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FastDbExplorer.Wpf.Localization"
             xmlns:views="clr-namespace:FastDbExplorer.Wpf.Views">
  <UserControl.Resources>
    <!-- Big card button that opens the map module: gradient icon tile + title + hint + chevron -->
    <Style x:Key="MapEntryButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{DynamicResource AccentSoftBrush}" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="14" Padding="14,12">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" /></Storyboard></BeginStoryboard></EventTrigger></Grid.Triggers>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="4*" MinWidth="340" />
      <ColumnDefinition Width="5*" />
    </Grid.ColumnDefinitions>

    <!-- Brand panel -->
    <Border Grid.Column="0" Padding="48">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#4F46E5" Offset="0" /><GradientStop Color="#7C3AED" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <StackPanel VerticalAlignment="Center">
        <Border Width="68" Height="68" CornerRadius="20" Background="#33FFFFFF" HorizontalAlignment="Left">
          <TextBlock Text="&#xE80A;" FontFamily="{StaticResource IconFont}" FontSize="32" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="FastDbExplorer" FlowDirection="LeftToRight" HorizontalAlignment="Left" FontSize="30"
                   FontWeight="Bold" Foreground="White" Margin="0,26,0,6" />
        <TextBlock Text="{x:Static l:Strings.Tagline}" FontSize="15" Foreground="#CCFFFFFF" Margin="0,0,0,34" />
        <DockPanel Margin="0,0,0,14">
          <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Foreground="White" Margin="0,4,12,0" />
          <TextBlock Text="{x:Static l:Strings.Brand1}" Foreground="#E6FFFFFF" TextWrapping="Wrap" />
        </DockPanel>
        <DockPanel Margin="0,0,0,14">
          <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Foreground="White" Margin="0,4,12,0" />
          <TextBlock Text="{x:Static l:Strings.Brand2}" Foreground="#E6FFFFFF" TextWrapping="Wrap" />
        </DockPanel>
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Foreground="White" Margin="0,4,12,0" />
          <TextBlock Text="{x:Static l:Strings.Brand3}" Foreground="#E6FFFFFF" TextWrapping="Wrap" />
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- Form -->
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="440" Margin="40,44,40,32" HorizontalAlignment="Center" Width="440">
        <TextBlock Text="{x:Static l:Strings.ConnectTitle}" Style="{StaticResource Title}" />
        <TextBlock Text="{x:Static l:Strings.ConnectSubtitle}" Style="{StaticResource Muted}" Margin="0,4,0,18" />

        <!-- Map entry: always visible at the top, no need to scroll to find it -->
        <Button Style="{StaticResource MapEntryButton}" Command="{Binding OpenMapCommand}" ToolTip="{x:Static l:Strings.OpenMap}" Margin="0,0,0,22">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Width="46" Height="46" CornerRadius="14">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#4F46E5" Offset="0" /><GradientStop Color="#7C3AED" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <views:MapIcon Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
              <TextBlock Text="{x:Static l:Strings.OpenMap}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Text="{x:Static l:MapEntryStrings.Hint}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="&#xE76B;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
          </Grid>
        </Button>

        <StackPanel Margin="0,0,0,18">
          <StackPanel.Style>
            <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible" />
              <Style.Triggers><DataTrigger Binding="{Binding Recent.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock Text="{x:Static l:Strings.Recent}" Style="{StaticResource FieldLabel}" />
          <ItemsControl ItemsSource="{Binding Recent}" IsTabStop="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <Button Style="{StaticResource RowButton}" Command="{Binding DataContext.UseRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                    <StackPanel>
                      <TextBlock Text="{Binding Server}" FlowDirection="LeftToRight" HorizontalAlignment="Left" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Description}" FlowDirection="LeftToRight" HorizontalAlignment="Left" Style="{StaticResource Muted}" />
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="{x:Static l:Strings.RemoveRecent}"
                          Command="{Binding DataContext.RemoveRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <TextBlock Text="{x:Static l:Strings.Server}" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Margin="0,0,0,16" />

        <TextBlock Text="{x:Static l:Strings.Authentication}" Style="{StaticResource FieldLabel}" />
        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="12" Padding="4" Margin="0,0,0,16">
          <UniformGrid Rows="1">
            <RadioButton Style="{StaticResource SegmentButton}" GroupName="auth" Content="{x:Static l:Strings.WindowsAuth}" IsChecked="{Binding UseWindowsAuth}" />
            <RadioButton Style="{StaticResource SegmentButton}" GroupName="auth" Content="{x:Static l:Strings.SqlAuth}" IsChecked="{Binding UseSqlAuth}" />
          </UniformGrid>
        </Border>

        <StackPanel Visibility="{Binding UseSqlAuth, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="{x:Static l:Strings.UserName}" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Margin="0,0,0,16" />
          <TextBlock Text="{x:Static l:Strings.Password}" Style="{StaticResource FieldLabel}" />
          <PasswordBox x:Name="PasswordInput" FlowDirection="LeftToRight" Margin="0,0,0,16" PasswordChanged="OnPasswordChanged" />
        </StackPanel>

        <CheckBox Content="{x:Static l:Strings.TrustCert}" IsChecked="{Binding TrustServerCertificate}" Margin="0,0,0,20" />

        <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,14">
          <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding ErrorMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource DangerBrush}" Margin="0,3,10,0" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
          </DockPanel>
        </Border>
        <Border Background="{DynamicResource SuccessSoftBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,14">
          <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding StatusMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
          <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap" />
        </Border>

        <ProgressBar IsIndeterminate="True" Margin="0,0,0,14" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource PrimaryButton}" Content="{x:Static l:Strings.Connect}" Command="{Binding ConnectCommand}" IsDefault="True" MinWidth="120" />
          <Button Content="{x:Static l:Strings.Test}" Command="{Binding TestCommand}" Margin="10,0,0,0" MinWidth="120" />
          <Button Content="{x:Static l:Strings.Cancel}" Command="{Binding CancelCommand}" Margin="10,0,0,0"
                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
