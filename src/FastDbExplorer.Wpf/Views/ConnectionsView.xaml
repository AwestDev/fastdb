<UserControl x:Class="FastDbExplorer.Wpf.Views.ConnectionsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FastDbExplorer.Wpf.Localization">
  <Grid Margin="26,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18">
      <TextBlock Text="{x:Static l:ShellStrings.ConnectionsTitle}" Style="{StaticResource Title}" />
      <TextBlock Text="{x:Static l:ShellStrings.ConnectionsSubtitle}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid Margin="4,0,4,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static l:ShellStrings.SavedProfiles}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="{x:Static l:ShellStrings.NewProfile}"
                    Command="{Binding NewProfileCommand}" />
          </Grid>
          <Grid Grid.Row="1">
            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="2">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                 Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0"
                                 ToolTip="{x:Static l:CredentialStrings.RememberedTooltip}"
                                 Visibility="{Binding RememberPassword, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <TextBlock Text="{Binding Server}" FlowDirection="LeftToRight" HorizontalAlignment="Left" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding Description}" FlowDirection="LeftToRight" HorizontalAlignment="Left" Style="{StaticResource Muted}" FontSize="11" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{x:Static l:ShellStrings.NoSavedProfiles}" TextAlignment="Center" VerticalAlignment="Center" Margin="18">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers><DataTrigger Binding="{Binding Profiles.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
          <TextBlock Grid.Row="2" Text="{x:Static l:CredentialStrings.PasswordStorageNote}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,12,4,2" />
        </Grid>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="650" HorizontalAlignment="Stretch">
            <TextBlock Text="{x:Static l:ShellStrings.ProfileDetails}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16" />

            <TextBlock Text="{x:Static l:ShellStrings.ProfileName}" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

            <TextBlock Text="{x:Static l:Strings.Server}" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Margin="0,0,0,14" />

            <TextBlock Text="{x:Static l:Strings.Authentication}" Style="{StaticResource FieldLabel}" />
            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="12" Padding="4" Margin="0,0,0,14">
              <UniformGrid Rows="1">
                <RadioButton Style="{StaticResource SegmentButton}" GroupName="profile-auth" Content="{x:Static l:Strings.WindowsAuth}" IsChecked="{Binding UseWindowsAuth}" />
                <RadioButton Style="{StaticResource SegmentButton}" GroupName="profile-auth" Content="{x:Static l:Strings.SqlAuth}" IsChecked="{Binding UseSqlAuth}" />
              </UniformGrid>
            </Border>

            <StackPanel Visibility="{Binding UseSqlAuth, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="{x:Static l:Strings.UserName}" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Margin="0,0,0,12" />

              <TextBlock Text="{x:Static l:CredentialStrings.PasswordLabel}" Style="{StaticResource FieldLabel}" />

              <!-- New profile, or "change password": editable input with a show/hide toggle (hidden by default). -->
              <Grid Margin="0,0,0,8" Visibility="{Binding IsPasswordEditable, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <PasswordBox x:Name="PasswordInput" FlowDirection="LeftToRight"
                             AutomationProperties.Name="{x:Static l:CredentialStrings.PasswordLabel}"
                             Visibility="{Binding IsPasswordMasked, Converter={StaticResource BoolToVis}}" />
                <TextBox x:Name="PasswordReveal" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"
                         AutomationProperties.Name="{x:Static l:CredentialStrings.PasswordLabel}"
                         Visibility="{Binding IsPasswordRevealed, Converter={StaticResource BoolToVis}}" />
                <Button Grid.Column="1" Margin="6,0,0,0" Command="{Binding TogglePasswordVisibilityCommand}">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                      <Setter Property="ToolTip" Value="{x:Static l:CredentialStrings.ShowPassword}" />
                      <Setter Property="AutomationProperties.Name" Value="{x:Static l:CredentialStrings.ShowPassword}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowPassword}" Value="True">
                          <Setter Property="ToolTip" Value="{x:Static l:CredentialStrings.HidePassword}" />
                          <Setter Property="AutomationProperties.Name" Value="{x:Static l:CredentialStrings.HidePassword}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                  <!-- Drawn as vector shapes (eye, plus a slash while the password is visible): no dependency on any icon font. -->
                  <Viewbox Width="20" Height="20">
                    <Canvas Width="24" Height="24">
                      <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Data="M12 5 C7 5 2.7 8.1 1 12 c1.7 3.9 6 7 11 7 s9.3 -3.1 11 -7 c-1.7 -3.9 -6 -7 -11 -7 z M12 8.5 a3.5 3.5 0 1 0 0 7 a3.5 3.5 0 1 0 0 -7 z M12 10.5 a1.5 1.5 0 1 0 0 3 a1.5 1.5 0 1 0 0 -3 z" />
                      <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Data="M3.5 2.5 L21.5 20.5 L20 22 L2 4 z"
                            Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVis}}" />
                    </Canvas>
                  </Viewbox>
                </Button>
              </Grid>

              <!-- Saved profile: the password is never shown and cannot be revealed; it can only be replaced. -->
              <Grid Margin="0,0,0,8" Visibility="{Binding IsStoredPasswordLocked, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="12,9"
                        AutomationProperties.Name="{x:Static l:CredentialStrings.StoredPasswordMaskLabel}">
                  <TextBlock Text="&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;" FlowDirection="LeftToRight" HorizontalAlignment="Left" Style="{StaticResource Muted}" />
                </Border>
                <Button Grid.Column="1" Margin="8,0,0,0" Content="{x:Static l:CredentialStrings.ChangePassword}" Command="{Binding ChangePasswordCommand}" />
              </Grid>

              <Button HorizontalAlignment="Left" Margin="0,0,0,8" Content="{x:Static l:CredentialStrings.CancelChangePassword}"
                      Command="{Binding CancelPasswordChangeCommand}"
                      Visibility="{Binding IsChangingPassword, Converter={StaticResource BoolToVis}}" />

              <TextBlock Text="{x:Static l:CredentialStrings.PasswordInputNote}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"
                         Visibility="{Binding IsPasswordEditable, Converter={StaticResource BoolToVis}}" />
              <TextBlock Text="{x:Static l:CredentialStrings.StoredPasswordNote}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"
                         Visibility="{Binding IsStoredPasswordLocked, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <CheckBox Content="{x:Static l:Strings.TrustCert}" IsChecked="{Binding TrustServerCertificate}" Margin="0,0,0,18" />

            <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,12"
                    Visibility="{Binding HasErrorMessage, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
            </Border>
            <Border Background="{DynamicResource SuccessSoftBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,12"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap" />
            </Border>

            <ProgressBar IsIndeterminate="True" Margin="0,0,0,12" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <WrapPanel>
              <Button Style="{StaticResource PrimaryButton}" Content="{x:Static l:ShellStrings.SaveProfile}" Command="{Binding SaveProfileCommand}" MinWidth="128" />
              <Button Content="{x:Static l:ShellStrings.DeleteProfile}" Command="{Binding DeleteProfileCommand}" IsEnabled="{Binding HasSelectedProfile}" Margin="8,0,0,0" />
              <Button Content="{x:Static l:ShellStrings.ConnectProfile}" Command="{Binding ConnectSelectedCommand}" IsEnabled="{Binding HasSelectedProfile}" IsDefault="True" Margin="8,0,0,0" />
              <Button Content="{x:Static l:Strings.Cancel}" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="8,0,0,0" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
