<UserControl x:Class="FastDbExplorer.Wpf.Views.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FastDbExplorer.Wpf.Localization">
  <UserControl.Resources>
    <LinearGradientBrush x:Key="HomeHeroBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#4F46E5" Offset="0" />
      <GradientStop Color="#6D45D8" Offset="0.58" />
      <GradientStop Color="#8B5CF6" Offset="1" />
    </LinearGradientBrush>
    <Style x:Key="HomeTile" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="16" Padding="18" BorderThickness="1"
                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.5" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Padding" Value="16" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.035" /></Setter.Value></Setter>
    </Style>
    <Style x:Key="MetricCaption" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
      <Setter Property="FontSize" Value="11" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.Triggers>
      <EventTrigger RoutedEvent="FrameworkElement.Loaded">
        <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" /></Storyboard></BeginStoryboard>
      </EventTrigger>
    </Grid.Triggers>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="1160" HorizontalAlignment="Stretch" Margin="30,26,30,30">

        <StackPanel Margin="0,0,0,20">
          <TextBlock Text="{x:Static l:ShellStrings.HomeEyebrow}" FontSize="11" FontWeight="Bold"
                     Foreground="{DynamicResource AccentBrush}" />
          <TextBlock Text="{x:Static l:ShellStrings.HomeWelcome}" Style="{StaticResource Title}" Margin="0,5,0,0" />
          <TextBlock Text="{x:Static l:ShellStrings.HomeSubtitle}" Style="{StaticResource Muted}" FontSize="13" Margin="0,5,0,0" />
        </StackPanel>

        <!-- Connection hero: connection state and a direct route into the main workflow. -->
        <Border CornerRadius="20" Padding="26" Background="{StaticResource HomeHeroBrush}" Margin="0,0,0,18">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" MaxWidth="690">
              <Border HorizontalAlignment="Left" CornerRadius="12" Background="#25FFFFFF" Padding="10,5" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="7" Height="7" Fill="#74F0C0" VerticalAlignment="Center" />
                  <TextBlock Text="{x:Static l:ShellStrings.HomeActiveConnection}" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" Margin="7,0,0,0" />
                  <TextBlock Text="·" Foreground="#DCD8FF" Margin="8,0" />
                  <TextBlock Text="{x:Static l:ShellStrings.HomeReadOnly}" Foreground="#FFFFFF" FontSize="11" />
                </StackPanel>
              </Border>
              <TextBlock Text="{x:Static l:ShellStrings.HomeHeroTitle}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF"
                         TextWrapping="Wrap" />
              <TextBlock Text="{x:Static l:ShellStrings.HomeHeroBody}" FontSize="13" Foreground="#EDEBFF"
                         TextWrapping="Wrap" Margin="0,8,0,0" />
              <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button Content="{x:Static l:ShellStrings.HomeLaunchExplorer}" Command="{Binding OpenExplorerCommand}"
                        Background="#FFFFFF" Foreground="#4F46E5" BorderBrush="#FFFFFF" FontWeight="SemiBold" Padding="18,9" />
                <TextBlock Text="{Binding ServerName}" FlowDirection="LeftToRight" Foreground="#FFFFFF" Opacity="0.92"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="14,0,0,0" MaxWidth="310" />
              </StackPanel>
            </StackPanel>
            <Grid Grid.Column="1" Width="150" Height="150" Margin="24,0,0,0" VerticalAlignment="Center">
              <Ellipse Width="126" Height="126" Stroke="#35FFFFFF" StrokeThickness="1" />
              <Ellipse Width="92" Height="92" Stroke="#50FFFFFF" StrokeThickness="1" />
              <Ellipse Width="58" Height="58" Fill="#25FFFFFF" />
              <TextBlock Text="&#xE80A;" FontFamily="{StaticResource IconFont}" FontSize="34" Foreground="#FFFFFF"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Ellipse Width="8" Height="8" Fill="#74F0C0" Margin="20,18,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" />
            </Grid>
          </Grid>
        </Border>

        <!-- Metrics are informational only; all actions remain on the existing ViewModel commands. -->
        <Grid Margin="0,0,0,22">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource MetricCard}" Margin="0,0,10,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}">
                <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="19" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="{Binding DatabasesText}" FontSize="17" FontWeight="Bold" />
                <TextBlock Text="{x:Static l:ShellStrings.HomeDatabaseMetric}" Style="{StaticResource MetricCaption}" Margin="0,3,0,0" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource MetricCard}" Margin="0,0,10,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource SuccessSoftBrush}">
                <TextBlock Text="&#xE823;" FontFamily="{StaticResource IconFont}" FontSize="19" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="{Binding MonitorsText}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{x:Static l:ShellStrings.HomeMonitorMetric}" Style="{StaticResource MetricCaption}" Margin="0,3,0,0" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource MetricCard}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource WarningSoftBrush}">
                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="19" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="{x:Static l:ShellStrings.HomeLive}" FontSize="16" FontWeight="Bold" />
                <TextBlock Text="{x:Static l:ShellStrings.HomeConnectionHealth}" Style="{StaticResource MetricCaption}" Margin="0,3,0,0" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>

        <!-- Clear shortcuts with a single, predictable action per card. -->
        <Grid Margin="0,0,0,22">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
            <TextBlock Text="{x:Static l:ShellStrings.HomeQuickStart}" FontSize="17" FontWeight="Bold" />
            <TextBlock Text="{x:Static l:ShellStrings.HomeQuickStartSub}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
          </StackPanel>
          <UniformGrid Grid.Row="1" Grid.ColumnSpan="3" Rows="1" Margin="0">
            <Button Style="{StaticResource HomeTile}" Command="{Binding OpenExplorerCommand}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Width="44" Height="44" CornerRadius="13" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left">
                  <TextBlock Text="&#xE80A;" FontFamily="{StaticResource IconFont}" FontSize="21" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Row="1" Text="{x:Static l:ShellStrings.NavExplorer}" FontSize="15" FontWeight="Bold" Margin="0,13,0,3" />
                <TextBlock Grid.Row="2" Text="{x:Static l:ShellStrings.ExplorerTileHint}" Style="{StaticResource Muted}" FontSize="12" />
              </Grid>
            </Button>
            <Button Style="{StaticResource HomeTile}" Command="{Binding OpenMapCommand}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Width="44" Height="44" CornerRadius="13" Background="{DynamicResource SuccessSoftBrush}" HorizontalAlignment="Left">
                  <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="21" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Row="1" Text="{x:Static l:ShellStrings.NavMap}" FontSize="15" FontWeight="Bold" Margin="0,13,0,3" />
                <TextBlock Grid.Row="2" Text="{x:Static l:ShellStrings.MapTileHint}" Style="{StaticResource Muted}" FontSize="12" />
              </Grid>
            </Button>
            <Button Style="{StaticResource HomeTile}" Command="{Binding OpenMonitoringCommand}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Width="44" Height="44" CornerRadius="13" Background="{DynamicResource WarningSoftBrush}" HorizontalAlignment="Left">
                  <TextBlock Text="&#xE823;" FontFamily="{StaticResource IconFont}" FontSize="21" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Row="1" Text="{x:Static l:ShellStrings.NavMonitoring}" FontSize="15" FontWeight="Bold" Margin="0,13,0,3" />
                <TextBlock Grid.Row="2" Text="{x:Static l:ShellStrings.MonitoringTileHint}" Style="{StaticResource Muted}" FontSize="12" />
              </Grid>
            </Button>
          </UniformGrid>
        </Grid>

        <!-- Recent alerts are left as data-bound alert items; clicking through opens the existing monitoring flow. -->
        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,8">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{x:Static l:ShellStrings.HomeActivity}" FontSize="17" FontWeight="Bold" />
              <TextBlock Text="{Binding MonitorsText}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="{x:Static l:ShellStrings.AllAlerts}"
                    Command="{Binding OpenMonitoringCommand}" VerticalAlignment="Center" />
            <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource LineBrush}" Height="1" Margin="0,14,0,4" />
            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{x:Static l:ShellStrings.NoAlertsYet}" Style="{StaticResource Muted}"
                       Margin="0,16,0,0" Visibility="{Binding HasNoAlerts, Converter={StaticResource BoolToVis}}" />
            <ItemsControl Grid.Row="2" Grid.ColumnSpan="2" ItemsSource="{Binding RecentAlerts}" IsTabStop="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource DangerSoftBrush}" VerticalAlignment="Top">
                      <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0">
                      <TextBlock Text="{Binding MonitorName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding TimeText}" FlowDirection="LeftToRight" Style="{StaticResource Muted}" FontSize="11"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>