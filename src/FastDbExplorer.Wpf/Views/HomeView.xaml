<UserControl x:Class="FastDbExplorer.Wpf.Views.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FastDbExplorer.Wpf.Localization"
             xmlns:views="clr-namespace:FastDbExplorer.Wpf.Views">
  <UserControl.Resources>
    <!-- Big clickable tile: icon + title + hint. Accent border on hover / keyboard focus. -->
    <Style x:Key="HomeTile" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="16" Padding="18" BorderThickness="1.5"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" /></Storyboard></BeginStoryboard></EventTrigger></Grid.Triggers>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="900" Margin="32,28,32,28">

        <TextBlock Text="{x:Static l:ShellStrings.HomeWelcome}" Style="{StaticResource Title}" />
        <TextBlock Text="{x:Static l:ShellStrings.HomeSubtitle}" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,20" />

        <!-- Connection summary -->
        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource SuccessSoftBrush}">
              <TextBlock Text="&#xE80A;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding ServerName}" FlowDirection="LeftToRight" HorizontalAlignment="Left" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{x:Static l:Strings.ConnectedReadOnly}" Style="{StaticResource Muted}" Margin="8,0,0,0" />
                <TextBlock Text="·" Style="{StaticResource Muted}" Margin="8,0,0,0" />
                <TextBlock Text="{Binding DatabasesText}" Style="{StaticResource Muted}" Margin="8,0,0,0" />
              </StackPanel>
            </StackPanel>
            <Button Grid.Column="2" Content="{x:Static l:Strings.Disconnect}" Command="{Binding DisconnectCommand}" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <!-- Shortcuts to the sections -->
        <UniformGrid Rows="1" Margin="0,0,-12,16">
          <Button Style="{StaticResource HomeTile}" Command="{Binding OpenExplorerCommand}">
            <StackPanel>
              <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left">
                <TextBlock Text="&#xE80A;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{x:Static l:ShellStrings.NavExplorer}" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,2" />
              <TextBlock Text="{x:Static l:ShellStrings.ExplorerTileHint}" Style="{StaticResource Muted}" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource HomeTile}" Command="{Binding OpenMapCommand}">
            <StackPanel>
              <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left">
                <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{x:Static l:ShellStrings.NavMap}" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,2" />
              <TextBlock Text="{x:Static l:ShellStrings.MapTileHint}" Style="{StaticResource Muted}" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource HomeTile}" Command="{Binding OpenMonitoringCommand}">
            <StackPanel>
              <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left">
                <TextBlock Text="&#xE823;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{x:Static l:ShellStrings.NavMonitoring}" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,2" />
              <TextBlock Text="{x:Static l:ShellStrings.MonitoringTileHint}" Style="{StaticResource Muted}" />
            </StackPanel>
          </Button>
        </UniformGrid>

        <!-- Latest alerts -->
        <Border Style="{StaticResource Card}" Padding="20">
          <StackPanel>
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{x:Static l:ShellStrings.LatestAlerts}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding MonitorsText}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="{x:Static l:ShellStrings.AllAlerts}" Command="{Binding OpenMonitoringCommand}" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{x:Static l:ShellStrings.NoAlertsYet}" Style="{StaticResource Muted}" FontSize="13" Margin="0,10,0,0"
                       Visibility="{Binding HasNoAlerts, Converter={StaticResource BoolToVis}}" />
            <ItemsControl ItemsSource="{Binding RecentAlerts}" IsTabStop="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,10,0,10">
                    <StackPanel>
                      <TextBlock Text="{Binding MonitorName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                      <TextBlock Text="{Binding TimeText}" FlowDirection="LeftToRight" HorizontalAlignment="Left" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
