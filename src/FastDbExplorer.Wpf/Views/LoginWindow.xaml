<Window x:Class="FastDbExplorer.Wpf.Views.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FastDbExplorer.Wpf.Localization"
        Title="{x:Static l:LoginStrings.Title}" Icon="pack://application:,,,/Assets/app.ico" Width="500" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft" UseLayoutRounding="True"
        FontFamily="{StaticResource AppFont}" FontSize="14" Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
  <Border Style="{StaticResource Card}" Margin="20" Padding="30">
    <StackPanel>
      <Border Width="58" Height="58" CornerRadius="18" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Right">
        <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="26" Foreground="{DynamicResource AccentBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <TextBlock Text="{x:Static l:LoginStrings.Title}" Style="{StaticResource Title}" FontSize="24" Margin="0,18,0,3" />
      <TextBlock Text="{x:Static l:LoginStrings.Subtitle}" Style="{StaticResource Muted}" Margin="0,0,0,20" />

      <TextBlock Text="{x:Static l:LoginStrings.UserName}" Style="{StaticResource FieldLabel}" />
      <TextBox x:Name="UserNameInput" Text="admin" FlowDirection="LeftToRight" Margin="0,0,0,14" />
      <TextBlock Text="{x:Static l:LoginStrings.Password}" Style="{StaticResource FieldLabel}" />
      <PasswordBox x:Name="PasswordInput" FlowDirection="LeftToRight" Margin="0,0,0,14" />

      <TextBlock x:Name="ErrorText" Text="{x:Static l:LoginStrings.InvalidCredentials}" Foreground="{DynamicResource DangerBrush}"
                 TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed" />
      <Button Style="{StaticResource PrimaryButton}" Content="{x:Static l:LoginStrings.SignIn}" IsDefault="True" Click="OnSignIn" MinHeight="42" />
      <Button Content="{x:Static l:LoginStrings.Cancel}" IsCancel="True" Margin="0,8,0,0" MinHeight="40" />

      <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="12,10" Margin="0,18,0,8">
        <TextBlock x:Name="DemoCredentialsText" Foreground="{DynamicResource AccentBrush}" FlowDirection="LeftToRight" HorizontalAlignment="Right" />
      </Border>
      <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="10" Padding="12,10">
        <TextBlock Text="{x:Static l:LoginStrings.SecurityWarning}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
      </Border>
    </StackPanel>
  </Border>
</Window>
