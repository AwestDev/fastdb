<UserControl x:Class="FastDbExplorer.Wpf.Views.MapSendPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FastDbExplorer.Wpf.Localization"
             x:Name="Root">
  <!--
    The ONE "show the selected rows on the map" panel, used by the Explorer and by the Monitoring result preview.
    It is a single compact row so the result table keeps the room: title, the two coordinate columns, a details button on one
    side; the selection chip and the one primary button ("send N rows to the map") on the other. The row wraps on a narrow window.
    Why the button is off is a tooltip (and a line under the row only when rows ARE selected but cannot be sent).
    The per-point details open as a second row only on demand. Everything is bound to dependency properties of this control.
  -->
  <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="12,8">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>

        <!-- Start side: title, columns, details -->
        <WrapPanel VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Margin="0,3,18,3" VerticalAlignment="Center">
            <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}">
              <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource AccentBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{x:Static l:MapSendStrings.Title}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Margin="0,3,14,3" VerticalAlignment="Center">
            <TextBlock Text="{x:Static l:MapSendStrings.LatitudeShort}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Width="150" FlowDirection="LeftToRight" ItemsSource="{Binding Columns, ElementName=Root}"
                      SelectedItem="{Binding LatitudeColumn, ElementName=Root, Mode=TwoWay}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Margin="0,3,14,3" VerticalAlignment="Center">
            <TextBlock Text="{x:Static l:MapSendStrings.LongitudeShort}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Width="150" FlowDirection="LeftToRight" ItemsSource="{Binding Columns, ElementName=Root}"
                      SelectedItem="{Binding LongitudeColumn, ElementName=Root, Mode=TwoWay}" />
          </StackPanel>

          <Button Margin="0,3,0,3" Padding="10,5" VerticalAlignment="Center" Click="OnDetailsClick">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{x:Static l:MapSendStrings.DetailsButton}" />
              <TextBlock Text="{Binding DetailsCountText, ElementName=Root}" Style="{StaticResource Muted}" Margin="6,0,0,0" />
              <Grid Width="16" Height="16" Margin="4,0,0,0">
                <Path Data="M4 6 L8 10 L12 6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5">
                  <Path.Style>
                    <Style TargetType="Path">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDetailsOpen, ElementName=Root}" Value="True">
                          <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" /></Setter.Value></Setter>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Path.Style>
                </Path>
              </Grid>
            </StackPanel>
          </Button>
        </WrapPanel>

        <!-- End side: how many rows are selected + the one action -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <Border CornerRadius="8" Padding="10,3" VerticalAlignment="Center" Margin="0,0,10,0"
                  ToolTip="{Binding Hint, ElementName=Root}" ToolTipService.IsEnabled="{Binding HasHint, ElementName=Root}">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedCount, ElementName=Root}" Value="0"><Setter Property="Background" Value="Transparent" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock Text="{Binding SelectionText, ElementName=Root}" FontSize="12" FontWeight="SemiBold">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedCount, ElementName=Root}" Value="0"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Border>
          <Button Style="{StaticResource PrimaryButton}" MinWidth="160"
                  Command="{Binding SendCommand, ElementName=Root}" IsEnabled="{Binding CanSend, ElementName=Root}"
                  Content="{Binding SendText, ElementName=Root}"
                  ToolTip="{Binding Hint, ElementName=Root}" ToolTipService.ShowOnDisabled="True"
                  ToolTipService.IsEnabled="{Binding HasHint, ElementName=Root}" />
        </StackPanel>
      </Grid>

      <!-- Rows are selected but cannot be sent: say why right here -->
      <TextBlock Text="{Binding Hint, ElementName=Root}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                 Visibility="{Binding HasProblemHint, ElementName=Root, Converter={StaticResource BoolToVis}}" />

      <!-- Optional details shown when the mouse is over a point on the map -->
      <StackPanel Margin="0,8,0,0" Visibility="{Binding IsDetailsOpen, ElementName=Root, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="{Binding DetailsNote, ElementName=Root}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="110">
          <ItemsControl ItemsSource="{Binding DetailColumns, ElementName=Root}" IsTabStop="False">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          FlowDirection="LeftToRight" Margin="0,0,14,6" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
