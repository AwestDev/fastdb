<UserControl x:Class="FastDbExplorer.Wpf.Views.MapView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FastDbExplorer.Wpf.Localization"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             AllowDrop="True" Drop="OnDrop">
  <UserControl.Resources>
    <!-- Map-panel styles. Kept here (not in Styles.xaml) so they can use the app styles as base; all brushes are DynamicResource (light + dark). -->

    <!-- Plain row (vector layer list): transparent, soft background on hover -->
    <Style x:Key="LayerRow" TargetType="Border">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,1" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" /></Trigger>
      </Style.Triggers>
    </Style>

    <!-- Excel layer card: hairline border, soft fill on hover -->
    <Style x:Key="LayerCard" TargetType="Border">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="0,0,6,6" />
    </Style>
    <Style x:Key="ChipText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style x:Key="MiniIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Padding" Value="7" />
      <Setter Property="FontSize" Value="13" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="DangerMiniIconButton" TargetType="Button" BasedOn="{StaticResource MiniIconButton}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
      <Setter Property="Padding" Value="12,6" />
    </Style>

    <!-- Square picker tile (marker icon / colour): soft hover, accent ring when selected -->
    <Style x:Key="ChoiceButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Box" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource SurfaceAltBrush}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" /></Storyboard></BeginStoryboard></EventTrigger></Grid.Triggers>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

    <!-- Toolbar: title on one side; two quiet icon buttons, a separator and the two real actions on the other -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="22,12">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{x:Static l:Strings.Map}" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" />
          <TextBlock Text="{Binding FileName}" Style="{StaticResource Muted}" FlowDirection="LeftToRight" Margin="14,0,0,0" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" MaxWidth="420" />
          <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="9" Padding="9,4" Margin="12,0,0,0" VerticalAlignment="Center"
                  Visibility="{Binding HasMap, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding FormatText}" FlowDirection="LeftToRight" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
          </Border>
          <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="9" Padding="9,4" Margin="8,0,0,0" VerticalAlignment="Center"
                  Visibility="{Binding HasQueryResultLayer, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding QueryResultLayerSummary}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <!-- picture of the map as it is shown now (PNG), including an open point card -->
          <Button Style="{StaticResource IconButton}" ToolTip="{x:Static l:MapUiStrings.Screenshot}" AutomationProperties.Name="{x:Static l:MapUiStrings.Screenshot}"
                  Click="OnScreenshotMenuClick" Visibility="{Binding HasMap, Converter={StaticResource BoolToVis}}">
            <Button.ContextMenu>
              <ContextMenu FlowDirection="RightToLeft">
                <MenuItem Header="{x:Static l:MapUiStrings.ScreenshotPng}" Click="OnScreenshotPngClick" />
                <MenuItem Header="{x:Static l:MapUiStrings.ScreenshotJpg}" Click="OnScreenshotJpgClick" />
              </ContextMenu>
            </Button.ContextMenu>
            <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Button>

          <!-- fit to map -->
          <Button Style="{StaticResource IconButton}" ToolTip="{x:Static l:Strings.FitToMap}" AutomationProperties.Name="{x:Static l:Strings.FitToMap}"
                  Command="{Binding FitCommand}" Visibility="{Binding HasMap, Converter={StaticResource BoolToVis}}">
            <Viewbox Width="18" Height="18">
              <Canvas Width="24" Height="24">
                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Data="M4 9 V4 h5 v2 H6 v3 z M15 4 h5 v5 h-2 V6 h-3 z M4 15 h2 v3 h3 v2 H4 z M18 15 h2 v5 h-5 v-2 h3 z" />
              </Canvas>
            </Viewbox>
          </Button>
          <!-- show / hide the side panel -->
          <Button Style="{StaticResource IconButton}" ToolTip="{x:Static l:Strings.ToggleLayers}" AutomationProperties.Name="{x:Static l:Strings.ToggleLayers}"
                  Command="{Binding ToggleLayersCommand}" Margin="2,0,0,0" Visibility="{Binding HasMap, Converter={StaticResource BoolToVis}}">
            <Viewbox Width="18" Height="18">
              <Canvas Width="24" Height="24">
                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Data="M3 4 h18 v16 H3 z M5 6 v12 h9 V6 z M16 6 v12 h3 V6 z" />
              </Canvas>
            </Viewbox>
          </Button>
          <!-- open the map in its own window (for a second monitor) or bring it back -->
          <Button Style="{StaticResource IconButton}" ToolTip="{Binding PopOutText}" AutomationProperties.Name="{Binding PopOutText}"
                  Command="{Binding ToggleWindowCommand}" Margin="2,0,0,0" Visibility="{Binding HasMap, Converter={StaticResource BoolToVis}}">
            <Viewbox Width="18" Height="18">
              <Canvas Width="24" Height="24">
                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Data="M3 3 h8 v2 H5 v14 h14 v-6 h2 v8 H3 z M14 3 h7 v7 h-2 V6.4 l-7.3 7.3 l-1.4 -1.4 L17.6 5 H14 z" />
              </Canvas>
            </Viewbox>
          </Button>
          <Border Width="1" Height="22" Background="{DynamicResource LineBrush}" Margin="10,0" VerticalAlignment="Center" />
          <Button Content="{x:Static l:Strings.OpenMapFile}" Command="{Binding OpenFileCommand}" />
          <Button Style="{StaticResource PrimaryButton}" Content="{x:Static l:MapUiStrings.AddExcelLayer}" Command="{Binding ImportExcelCommand}" Margin="8,0,0,0"
                  Visibility="{Binding HasMap, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Map | one side panel with two tabs -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>

      <Grid Grid.Column="0">
        <!-- Visibility is set from code-behind: the map is hidden while it is in its own window (see UpdateWebVisibility) -->
        <wv2:WebView2 x:Name="Web" />

        <!-- Empty / problem state (the WebView is a native window, so this is shown instead of it, not on top) -->
        <Border MaxWidth="540" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="Visible" />
              <Style.Triggers><DataTrigger Binding="{Binding HasMap}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel>
            <Border Width="64" Height="64" CornerRadius="20" HorizontalAlignment="Left" Margin="0,0,0,16">
              <Border.Style>
                <Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                  <Style.Triggers><DataTrigger Binding="{Binding InfoIsProblem}" Value="True"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" /></DataTrigger></Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <TextBlock Text="{Binding InfoTitle}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding InfoBody}" Style="{StaticResource Muted}" FontSize="13" Margin="0,8,0,18" />
            <TextBlock Text="{x:Static l:Strings.MapQueryPending}" Foreground="{DynamicResource AccentBrush}"
                       TextWrapping="Wrap" Margin="0,-8,0,14" Visibility="{Binding HasQueryResultLayer, Converter={StaticResource BoolToVis}}" />
            <ProgressBar IsIndeterminate="True" Margin="0,0,0,14" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            <Button Style="{StaticResource PrimaryButton}" Content="{x:Static l:Strings.OpenMapFile}" Command="{Binding OpenFileCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>

        <!-- Shown in the Map section while the map is in its own window (visibility is set from code-behind, see UpdateWebVisibility) -->
        <Border x:Name="DetachedNote" MaxWidth="540" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" Style="{StaticResource Card}"
                Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="{x:Static l:MapUiStrings.PoppedOutTitle}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{x:Static l:MapUiStrings.PoppedOutBody}" Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,18" />
            <Button Style="{StaticResource PrimaryButton}" Content="{x:Static l:MapUiStrings.DockBack}" Command="{Binding ToggleWindowCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Side panel: beside the map, never over it (WebView2 airspace) -->
      <Border Grid.Column="1" Width="350" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0"
              Visibility="{Binding ShowSidePanel, Converter={StaticResource BoolToVis}}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

          <!-- Tabs -->
          <Border Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="12" Padding="4" Margin="14,14,14,10">
            <UniformGrid Rows="1">
              <RadioButton Style="{StaticResource SegmentButton}" GroupName="map-tab" Content="{Binding ExcelTabText}" IsChecked="{Binding IsExcelTab}" />
              <RadioButton Style="{StaticResource SegmentButton}" GroupName="map-tab" Content="{Binding MapTabText}" IsChecked="{Binding IsMapLayersTab}" />
            </UniformGrid>
          </Border>

          <!-- Tab 1: Excel point layers -->
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsExcelTab, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="14,2,14,14">

              <TextBlock Text="{Binding CoordinateStatus}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                         Visibility="{Binding HasCoordinateStatus, Converter={StaticResource BoolToVis}}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                    <Style.Triggers><DataTrigger Binding="{Binding CoordinateStatusIsProblem}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger></Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>

              <!-- Nothing imported yet -->
              <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="14" Padding="16" Margin="0,0,0,10"
                      Visibility="{Binding ShowEmptyExcelHint, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                  <TextBlock Text="{x:Static l:MapUiStrings.EmptyExcelTitle}" FontWeight="SemiBold" FontSize="14" />
                  <TextBlock Text="{x:Static l:MapUiStrings.EmptyExcelBody}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,12" />
                  <Button Style="{StaticResource PrimaryButton}" Content="{x:Static l:MapUiStrings.AddExcelLayer}" Command="{Binding ImportExcelCommand}" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>

              <ItemsControl ItemsSource="{Binding CoordinateLayers}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource LayerCard}">
                      <StackPanel>

                        <!-- Header: marker preview | name + summary | zoom | visible | settings -->
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Border Width="36" Height="36" CornerRadius="18" Background="{Binding ColorBrush}" VerticalAlignment="Center">
                            <Grid>
                              <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}">
                                <Canvas Width="24" Height="24"><Path Data="{Binding IconShape}" Fill="White" /></Canvas>
                              </Viewbox>
                              <Ellipse Width="10" Height="10" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasNoIcon, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                          </Border>
                          <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Button Grid.Column="2" Style="{StaticResource MiniIconButton}" Content="&#xE8A3;" ToolTip="{x:Static l:CoordinateStrings.ZoomToLayer}" Command="{Binding ZoomCommand}" />
                          <CheckBox Grid.Column="3" IsChecked="{Binding IsVisible}" VerticalAlignment="Center" Margin="4,0"
                                    ToolTip="{x:Static l:MapUiStrings.ToggleVisibility}" AutomationProperties.Name="{x:Static l:MapUiStrings.ToggleVisibility}" />
                          <Button Grid.Column="4" Style="{StaticResource MiniIconButton}" Command="{Binding ToggleExpandedCommand}"
                                  ToolTip="{x:Static l:MapUiStrings.LayerSettings}" AutomationProperties.Name="{x:Static l:MapUiStrings.LayerSettings}">
                            <Grid Width="16" Height="16">
                              <Path Data="M4 6 L8 10 L12 6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8"
                                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5">
                                <Path.Style>
                                  <Style TargetType="Path">
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" /></Setter.Value></Setter>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Path.Style>
                              </Path>
                            </Grid>
                          </Button>
                        </Grid>

                        <!-- Settings (collapsed by default, so the list stays calm) -->
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                          <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,0,0,12" />
                          <TextBlock Text="{Binding FileName}" Style="{StaticResource Muted}" FlowDirection="LeftToRight" HorizontalAlignment="Left"
                                     TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" Margin="0,0,0,12" />

                          <!-- Marker icon: the current one on a button; the folders (categories) and their icons open in a popup -->
                          <TextBlock Text="{x:Static l:MapUiStrings.MarkerLabel}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                          <Button x:Name="IconTrigger" Command="{Binding ToggleIconPickerCommand}" HorizontalContentAlignment="Stretch" Padding="8,6" Margin="0,0,0,4"
                                  AutomationProperties.Name="{x:Static l:MapUiStrings.MarkerLabel}" ToolTip="{x:Static l:MapUiStrings.MarkerPickerHint}">
                            <Grid>
                              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                              <Viewbox Width="22" Height="22">
                                <Canvas Width="24" Height="24"><Path Data="{Binding DisplayIconShape}" Fill="{Binding ColorBrush}" /></Canvas>
                              </Viewbox>
                              <TextBlock Grid.Column="1" Text="{Binding CurrentIconName}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                              <Path Grid.Column="2" Data="M4 6 L8 10 L12 6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                            </Grid>
                          </Button>
                          <Popup PlacementTarget="{Binding ElementName=IconTrigger}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                 IsOpen="{Binding IsIconPickerOpen, Mode=TwoWay}">
                            <Border Width="330" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="10" Margin="0,4,0,0">
                              <StackPanel>
                                <!-- Folder tabs -->
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                                  <ItemsControl ItemsSource="{Binding IconCategories}" IsTabStop="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate>
                                        <Button Content="{Binding Name}" CommandParameter="{Binding}" Command="{Binding DataContext.SelectIconCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                AutomationProperties.Name="{Binding Name}" Margin="0,0,6,0">
                                          <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                              <Setter Property="Padding" Value="10,4" />
                                              <Setter Property="FontSize" Value="12" />
                                              <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                  <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                  <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                              </Style.Triggers>
                                            </Style>
                                          </Button.Style>
                                        </Button>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </ScrollViewer>

                                <!-- Icons of the open folder -->
                                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                  <ItemsControl ItemsSource="{Binding SelectedIconCategory.Icons}" IsTabStop="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Width="300" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate>
                                        <Button Command="{Binding SelectCommand}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                                                Width="40" Height="40" Margin="1">
                                          <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ChoiceButton}">
                                              <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                  <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                  <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                              </Style.Triggers>
                                            </Style>
                                          </Button.Style>
                                          <Viewbox Width="22" Height="22">
                                            <Canvas Width="24" Height="24">
                                              <Path Data="{Binding Shape}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </Canvas>
                                          </Viewbox>
                                        </Button>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </ScrollViewer>
                              </StackPanel>
                            </Border>
                          </Popup>

                          <!-- Marker colour -->
                          <TextBlock Text="{x:Static l:MapUiStrings.ColorLabel}" Style="{StaticResource FieldLabel}" Margin="0,6,0,6" />
                          <ItemsControl ItemsSource="{Binding ColorChoices}" IsTabStop="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Button Style="{StaticResource ChoiceButton}" Command="{Binding SelectCommand}" ToolTip="{Binding Hex}" AutomationProperties.Name="{Binding Hex}">
                                  <Ellipse Width="18" Height="18" Fill="{Binding Brush}" />
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>

                          <!-- Radius -->
                          <TextBlock Text="{x:Static l:CoordinateStrings.RadiusLabel}" Style="{StaticResource FieldLabel}" Margin="0,6,0,4" />
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding RadiusText, UpdateSourceTrigger=PropertyChanged}" Padding="10,7" FlowDirection="LeftToRight" ToolTip="{x:Static l:CoordinateStrings.RadiusTip}">
                              <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding ApplyRadiusCommand}" /></TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1" Content="{x:Static l:CoordinateStrings.Apply}" Command="{Binding ApplyRadiusCommand}" Padding="14,7" Margin="6,0,0,0" />
                          </Grid>
                          <TextBlock Text="{Binding RadiusError}" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                     Visibility="{Binding HasRadiusError, Converter={StaticResource BoolToVis}}" />

                          <!-- Inline rename editor -->
                          <Grid Margin="0,12,0,0" Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" MaxLength="100" IsVisibleChanged="OnRenameBoxVisibleChanged">
                              <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding CommitRenameCommand}" />
                                <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}" />
                              </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1" Style="{StaticResource MiniIconButton}" Content="&#xE73E;" Margin="4,0,0,0"
                                    ToolTip="{x:Static l:CoordinateStrings.SaveName}" Command="{Binding CommitRenameCommand}" />
                            <Button Grid.Column="2" Style="{StaticResource DangerMiniIconButton}" Content="&#xE711;"
                                    ToolTip="{x:Static l:CoordinateStrings.CancelEdit}" Command="{Binding CancelRenameCommand}" />
                          </Grid>
                          <TextBlock Text="{Binding EditError}" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                     Visibility="{Binding HasEditError, Converter={StaticResource BoolToVis}}" />

                          <!-- Actions: rename / refresh on one side, delete (with inline confirmation) on the other -->
                          <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                              <Button Style="{StaticResource MiniIconButton}" Content="&#xE70F;" ToolTip="{x:Static l:CoordinateStrings.RenameLayer}"
                                      Command="{Binding BeginRenameCommand}" Visibility="{Binding IsNotRenaming, Converter={StaticResource BoolToVis}}" />
                              <Button Style="{StaticResource MiniIconButton}" Content="&#xE72C;" ToolTip="{x:Static l:CoordinateStrings.RefreshLayer}" Command="{Binding RefreshCommand}" Margin="4,0,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource DangerMiniIconButton}" Content="&#xE74D;" ToolTip="{x:Static l:CoordinateStrings.RemoveLayer}"
                                    Command="{Binding RequestDeleteCommand}" Visibility="{Binding IsNotConfirmingDelete, Converter={StaticResource BoolToVis}}" />
                            <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                        Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BoolToVis}}">
                              <TextBlock Text="{x:Static l:CoordinateStrings.ConfirmRemoveQuestion}" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0" />
                              <Button Style="{StaticResource DangerButton}" Content="{x:Static l:CoordinateStrings.ConfirmRemoveYes}" Command="{Binding ConfirmDeleteCommand}" />
                              <Button Content="{x:Static l:CoordinateStrings.ConfirmRemoveNo}" Command="{Binding CancelDeleteCommand}" Padding="12,6" Margin="6,0,0,0" />
                            </StackPanel>
                          </Grid>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <!-- Tab 2: layers of the opened map file -->
          <Grid Grid.Row="1" Visibility="{Binding IsMapLayersTab, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="14,2,14,8" Visibility="{Binding HasLayers, Converter={StaticResource BoolToVis}}">
              <Button Content="{x:Static l:MapUiStrings.ShowAll}" Command="{Binding ShowAllMapLayersCommand}" Padding="12,5" />
              <Button Content="{x:Static l:MapUiStrings.HideAll}" Command="{Binding HideAllMapLayersCommand}" Padding="12,5" Margin="6,0,0,0" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight" Margin="14,0,14,14">
              <ItemsControl ItemsSource="{Binding Layers}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource LayerRow}">
                      <CheckBox Content="{Binding Name}" IsChecked="{Binding IsVisible}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock Grid.Row="1" Text="{x:Static l:MapUiStrings.NoMapLayers}" Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"
                       VerticalAlignment="Center" Margin="24" Visibility="{Binding HasNoMapLayers, Converter={StaticResource BoolToVis}}" />
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- Status bar: zoom | point under the mouse | cursor position -->
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,6">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding ZoomText}" Style="{StaticResource Muted}" />
        <TextBlock Grid.Column="1" Text="{Binding HoverText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="16,0" />
        <TextBlock Grid.Column="2" Text="{Binding CursorText}" Style="{StaticResource Muted}" FlowDirection="LeftToRight" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
