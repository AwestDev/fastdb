<Window x:Class="FastDbExplorer.Wpf.Views.MapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نقشه — GeoNexus" Width="1280" Height="820" MinWidth="720" MinHeight="480"
        Background="{DynamicResource BgBrush}" FlowDirection="LeftToRight">
  <!--
    The window itself is left-to-right: a right-to-left window would mirror the system title bar and put the minimize / maximize / close
    buttons on the left (the main window avoids that with its own title bar). The content (a MapView marked as detached) is set in
    code-behind, because it must be created with its flag; that is where it is switched back to right-to-left.
  -->
</Window>
