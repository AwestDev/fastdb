<UserControl x:Class="FastDbExplorer.Wpf.Views.MonitoringView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FastDbExplorer.Wpf.Localization"
             xmlns:vm="clr-namespace:FastDbExplorer.Wpf.ViewModels"
             xmlns:views="clr-namespace:FastDbExplorer.Wpf.Views">
  <UserControl.Resources>
    <DataTemplate DataType="{x:Type vm:MonitorEditorViewModel}"><views:MonitorEditorView /></DataTemplate>

    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="0,0,6,6" />
    </Style>
    <Style x:Key="ChipText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" /></Storyboard></BeginStoryboard></EventTrigger></Grid.Triggers>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

    <!-- Toolbar -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,10">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
          <TextBlock Text="{x:Static l:MonitoringStrings.Title}" FontSize="18" FontWeight="Bold" />
          <TextBlock Text="{x:Static l:MonitoringStrings.Subtitle}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
        </StackPanel>
        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="{x:Static l:MonitoringStrings.NewMonitor}" Command="{Binding NewMonitorCommand}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <!-- List mode: monitors | alerts. Hidden while the editor is open. -->
      <Grid Margin="24,20,24,20">
        <Grid.Style>
          <Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding Editor}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
          </Style>
        </Grid.Style>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource DangerSoftBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,14">
          <Border.Style>
            <Style TargetType="Border"><Setter Property="Visibility" Value="Visible" />
              <Style.Triggers><DataTrigger Binding="{Binding ErrorMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="380" /></Grid.ColumnDefinitions>

          <!-- Monitors -->
          <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,0">
              <TextBlock Text="{x:Static l:MonitoringStrings.NoMonitors}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,16"
                         Visibility="{Binding HasNoMonitors, Converter={StaticResource BoolToVis}}" />
              <ItemsControl ItemsSource="{Binding Monitors}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                      <StackPanel>
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Target}" FlowDirection="LeftToRight" HorizontalAlignment="Left" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                          </StackPanel>
                          <CheckBox Grid.Column="1" Content="{x:Static l:MonitoringStrings.Enabled}" VerticalAlignment="Top"
                                    IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                    Command="{Binding DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </Grid>

                        <WrapPanel Margin="0,10,0,0">
                          <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding IntervalText}" Style="{StaticResource ChipText}" /></Border>
                          <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding LastCheckedText}" Style="{StaticResource ChipText}" /></Border>
                        </WrapPanel>

                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding HasProblem}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                                <DataTrigger Binding="{Binding StatusText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}" />

                        <Grid Margin="0,12,0,0">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                          <StackPanel Orientation="Horizontal">
                            <Button Content="{x:Static l:MonitoringStrings.CheckNow}" Padding="12,6"
                                    Command="{Binding DataContext.CheckNowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            <Button Content="{x:Static l:MonitoringStrings.Edit}" Padding="12,6" Margin="8,0,0,0"
                                    Command="{Binding DataContext.EditMonitorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{x:Static l:MonitoringStrings.Delete}" Padding="12,6" Foreground="{DynamicResource DangerBrush}"
                                    Command="{Binding RequestDeleteCommand}" Visibility="{Binding IsNotConfirmingDelete, Converter={StaticResource BoolToVis}}" />
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BoolToVis}}">
                              <TextBlock Text="{x:Static l:MonitoringStrings.ConfirmDeleteQuestion}" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0" />
                              <Button Content="{x:Static l:MonitoringStrings.Yes}" Padding="12,6" Foreground="{DynamicResource DangerBrush}"
                                      Command="{Binding DataContext.DeleteMonitorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                              <Button Content="{x:Static l:MonitoringStrings.No}" Padding="12,6" Margin="6,0,0,0" Command="{Binding CancelDeleteCommand}" />
                            </StackPanel>
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{x:Static l:MonitoringStrings.RunningNote}" Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
          </ScrollViewer>

          <!-- Alerts -->
          <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14" Margin="16,0,0,0">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{x:Static l:MonitoringStrings.Alerts}" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                <Border Style="{StaticResource Chip}" Margin="8,0,0,0"><TextBlock Text="{Binding Alerts.Count}" Style="{StaticResource ChipText}" /></Border>
              </StackPanel>
              <TextBlock Grid.Row="1" Text="{x:Static l:MonitoringStrings.NoAlerts}" Style="{StaticResource Muted}" TextWrapping="Wrap"
                         Visibility="{Binding HasNoAlerts, Converter={StaticResource BoolToVis}}" />
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Alerts}" IsTabStop="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,8,0,10">
                        <StackPanel>
                          <TextBlock Text="{Binding MonitorName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                          <TextBlock Text="{Binding TimeText}" FlowDirection="LeftToRight" HorizontalAlignment="Left" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                          <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource LinkButton}" Content="{x:Static l:MonitoringStrings.OpenReport}"
                                    Command="{Binding DataContext.OpenReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            <Button Style="{StaticResource LinkButton}" Content="{x:Static l:MonitoringStrings.ShowInFolder}"
                                    Command="{Binding DataContext.ShowReportInFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                          </StackPanel>
                          <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                  Content="{x:Static l:MonitoringStrings.ShowResults}"
                                  Command="{Binding DataContext.ShowResultsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"
                                  Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <!-- Editor mode -->
      <ContentControl Content="{Binding Editor}" IsTabStop="False" />

      <!-- Inline result preview, kept separate from Excel export and the map screen. -->
      <Border Margin="20" Padding="18" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="16">
        <Border.Style>
          <Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding IsResultPreviewVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{x:Static l:MonitoringStrings.ResultsTitle}" FontSize="18" FontWeight="Bold" />
              <TextBlock Text="{Binding PreviewTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
              <TextBlock Text="{Binding PreviewTarget}" FlowDirection="LeftToRight" HorizontalAlignment="Left"
                         Style="{StaticResource Muted}" Margin="0,2,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="{x:Static l:MonitoringStrings.CloseResults}"
                    Command="{Binding CloseResultsCommand}" VerticalAlignment="Top" />
          </Grid>

          <!-- The same "show on the map" panel as the Explorer -->
          <views:MapSendPanel Grid.Row="1" Margin="0,12,0,12"
                              Columns="{Binding PreviewColumns}"
                              LatitudeColumn="{Binding LatitudeColumn, Mode=TwoWay}"
                              LongitudeColumn="{Binding LongitudeColumn, Mode=TwoWay}"
                              DetailColumns="{Binding MapDetailColumns}"
                              DetailCount="{Binding MapDetailColumnCount}"
                              SelectedCount="{Binding SelectedResultRowCount}"
                              IsSendEnabled="{Binding IsMapSendEnabled}"
                              SendCommand="{Binding SendSelectedRowsToMapCommand}" />

          <DataGrid x:Name="PreviewGrid" Grid.Row="2" ItemsSource="{Binding PreviewRows}"
                    FlowDirection="LeftToRight" SelectionMode="Extended" SelectionUnit="FullRow"
                    EnableRowVirtualization="True" EnableColumnVirtualization="True"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                    ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" />

          <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding PreviewRowCountText}" Style="{StaticResource Muted}" />
            <TextBlock Text="{Binding PreviewStatus}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
