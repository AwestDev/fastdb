<Window x:Class='FastDbExplorer.Wpf.Views.SplashWindow' xmlns='http://schemas.microsoft.com/winfx/2006/xaml/presentation' xmlns:x='http://schemas.microsoft.com/winfx/2006/xaml'
        xmlns:l='clr-namespace:FastDbExplorer.Wpf.Localization'
        Title='{x:Static l:WindowStrings.AppName}' Icon='pack://application:,,,/Assets/app.ico'
        Width='1200' Height='800' WindowStyle='None' AllowsTransparency='True' Background='Transparent'
        ResizeMode='NoResize' ShowInTaskbar='False' WindowStartupLocation='CenterScreen'
        UseLayoutRounding='True' FontFamily='{StaticResource AppFont}'>
  <!-- Full-bleed GeoNexus splash artwork (1536x1024 design, shown at 1200x800). Branding and the
       loading label are part of the image; live progress is drawn over its loading strip. -->
  <Grid Width='1200' Height='800' FlowDirection='LeftToRight'>
    <Grid.Clip><RectangleGeometry Rect='0,0,1200,800' RadiusX='16' RadiusY='16' /></Grid.Clip>
    <Canvas Width='1200' Height='800'>

      <Image Canvas.Left='0' Canvas.Top='0' Width='1200' Height='800' Stretch='Fill'
             Source='pack://application:,,,/Assets/splash.png' />

      <!-- Loading strip: cover the baked gradient bar with a track, then draw live progress on it. -->
      <Rectangle Canvas.Left='75' Canvas.Top='681' Width='344' Height='4' Fill='#18223B' />
      <Border x:Name='ProgressFill' Canvas.Left='75' Canvas.Top='681' Width='0' Height='4'>
        <Border.Background>
          <LinearGradientBrush StartPoint='0,0' EndPoint='1,0'>
            <GradientStop Color='#168CFF' Offset='0' /><GradientStop Color='#7957FF' Offset='1' />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Border x:Name='ProgressShimmer' Canvas.Left='75' Canvas.Top='681' Width='40' Height='4' Background='#8CFFFFFF' Opacity='0.4'>
        <Border.RenderTransform><TranslateTransform X='0' /></Border.RenderTransform>
        <Border.Triggers>
          <EventTrigger RoutedEvent='FrameworkElement.Loaded'>
            <BeginStoryboard>
              <Storyboard RepeatBehavior='Forever'>
                <DoubleAnimation Storyboard.TargetName='ProgressShimmer' Storyboard.TargetProperty='(UIElement.RenderTransform).(TranslateTransform.X)' From='-40' To='344' Duration='0:0:1.2' />
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Border.Triggers>
      </Border>

      <!-- Live step text, under the slogan -->
      <TextBlock x:Name='StatusText' Canvas.Left='75' Canvas.Top='726' Width='520' FontSize='13' Foreground='#829BBE' TextWrapping='Wrap' />
      <TextBlock x:Name='SubStatusText' Canvas.Left='75' Canvas.Top='750' Width='520' FontSize='11' Foreground='#5F7A9E' TextWrapping='Wrap' />

      <!-- Version, bottom-right -->
      <TextBlock x:Name='VersionText' Canvas.Right='24' Canvas.Bottom='16' FontSize='11' Foreground='#5F7A9E' />

      <!-- Kept for the code-behind; not shown in the design -->
      <TextBlock x:Name='PercentageText' Visibility='Collapsed' Text='0%' />
      <StackPanel x:Name='StepsPanel' Visibility='Collapsed' />
    </Canvas>
  </Grid>
</Window>
