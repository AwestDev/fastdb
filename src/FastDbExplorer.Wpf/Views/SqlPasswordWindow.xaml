<Window x:Class="FastDbExplorer.Wpf.Views.SqlPasswordWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FastDbExplorer.Wpf.Localization"
        Title="{x:Static l:ShellStrings.SqlPasswordTitle}" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" UseLayoutRounding="True"
        FontFamily="{StaticResource AppFont}" FontSize="14" Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
  <Border Style="{StaticResource Card}" Margin="16" Padding="24">
    <StackPanel>
      <TextBlock Text="{x:Static l:ShellStrings.SqlPasswordTitle}" FontSize="20" FontWeight="Bold" />
      <TextBlock x:Name="ProfileText" FlowDirection="LeftToRight" HorizontalAlignment="Left" Style="{StaticResource Muted}" Margin="0,5,0,14" />
      <TextBlock Text="{x:Static l:ShellStrings.SqlPasswordPromptNote}" Style="{StaticResource Muted}" Margin="0,0,0,14" />
      <TextBlock Text="{x:Static l:Strings.Password}" Style="{StaticResource FieldLabel}" />
      <PasswordBox x:Name="PasswordInput" FlowDirection="LeftToRight" Margin="0,0,0,18" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <Button Style="{StaticResource PrimaryButton}" Content="{x:Static l:ShellStrings.ConnectProfile}" IsDefault="True" Click="OnConnect" MinWidth="116" />
        <Button Content="{x:Static l:Strings.Cancel}" IsCancel="True" Margin="8,0,0,0" MinWidth="96" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
